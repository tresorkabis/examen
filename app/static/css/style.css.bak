/* ==========================================================================
   ExamManager — Design optimisé
   ========================================================================== */

/* --- Variables de thème --- */
:root {
  --color-brand: #1a365d;
  --color-brand-dark: #152d4f;
  --color-primary: #2d8cff;
  --color-primary-hover: #1e77e4;
  --color-success: #059669;
  --color-info: #0891b2;
  --color-warning: #d97706;
  --color-danger: #dc2626;
  --color-gray-50: #f8fafc;
  --color-gray-100: #f1f5f9;
  --color-gray-200: #e2e8f0;
  --color-gray-300: #cbd5e1;
  --color-gray-400: #94a3b8;
  --color-gray-500: #64748b;
  --color-gray-600: #475569;
  --color-gray-700: #1e293b;
  --color-gray-800: #0f172a;
  --color-gray-900: #020617;
  --color-white: #ffffff;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --radius: 0.75rem;
  --radius-sm: 0.5rem;
  --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  background-color: var(--color-gray-100);
  color: #34475b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 0.95rem;
  line-height: 1.55;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

h1, h2, h3, h4, h5, h6 {
  color: var(--color-gray-900);
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.25;
}

h1 { font-size: 1.75rem; }
h2 { font-size: 1.5rem; }
h3 { font-size: 1.25rem; }

p { color: #4b5a6b; }

a { color: var(--color-primary); text-decoration: none; transition: var(--transition); }
a:hover { color: var(--color-brand-dark); }

.text-brand { color: var(--color-brand) !important; }
.bg-brand { background-color: var(--color-brand) !important; }

/* --- Boutons --- */
.btn {
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 0.55rem 1.1rem;
  transition: var(--transition);
  border: none;
}

.btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); }
.btn:active { transform: translateY(0); }

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-brand));
  color: #fff;
}

.btn-primary:hover {
  background: linear-gradient(135deg, var(--color-brand), var(--color-primary));
  color: #fff;
}

.btn-outline-secondary {
  color: var(--color-gray-500);
  border: 1px solid var(--color-gray-200);
}

.btn-outline-secondary:hover {
  background: var(--color-gray-900);
  color: #fff;
  border-color: var(--color-gray-900);
}

.btn-danger { background: var(--color-danger); }
.btn-success { background: var(--color-success); }
.btn-info { background: var(--color-info); color: #000; }
.btn-warning { background: var(--color-warning); color: #000; }

.btn-group-sm > .btn, .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.82rem; }

/* --- Formulaires --- */
.form-label {
  font-weight: 600;
  font-size: 0.85rem;
  color: var(--color-gray-900);
  margin-bottom: 0.4rem;
  display: block;
}

.form-control, .form-select {
  border-radius: var(--radius-sm);
  border: 1px solid #d1d9e2;
  padding: 0.55rem 0.9rem;
  font-size: 0.9rem;
  background: #fff;
  transition: var(--transition);
}

.form-control:focus, .form-select:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 0.3rem rgba(13, 110, 253, 0.15);
  outline: none;
}

.form-control.is-invalid, .form-select.is-invalid {
  border-color: var(--color-danger);
}

.invalid-feedback { color: var(--color-danger); font-size: 0.82rem; }

.input-group .form-control { border-radius: var(--radius-sm) 0 0 var(--radius-sm); }
.input-group .btn { border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }

/* --- Alertes --- */
.alert {
  border: none;
  border-radius: var(--radius-sm);
  padding: 1rem 1.25rem;
  font-size: 0.9rem;
}

.alert-dismissible .btn-close { padding: 0.8rem; }

/* --- Pagination --- */
.pagination {
  display: flex;
  gap: 0.3rem;
  justify-content: center;
  margin-top: 1.5rem;
}

.pagination .page-link {
  border: 1px solid var(--color-gray-200);
  color: var(--color-gray-500);
  border-radius: var(--radius-sm);
  padding: 0.5rem 0.85rem;
  margin: 0;
  background: #fff;
  transition: var(--transition);
}

.pagination .page-link:hover { color: var(--color-primary); border-color: var(--color-primary); }
.pagination .page-item.active .page-link {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}
.pagination .page-item.disabled .page-link { color: #adb5bd; border-color: var(--color-gray-200); }

/* --- Stat cards (dashboard) --- */
.stat-card {
  background: #fff;
  border-radius: var(--radius);
  padding: 1.25rem 1.5rem;
  box-shadow: var(--shadow-sm);
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  transition: var(--transition);
  border: 1px solid var(--color-gray-200);
}

.stat-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }

.stat-head { display: flex; justify-content: space-between; align-items: flex-start; }
.stat-num { font-size: 1.75rem; font-weight: 800; color: var(--color-gray-900); line-height: 1; }
.stat-txt { font-size: 0.85rem; color: var(--color-gray-500); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
.stat-icon {
  width: 3rem; height: 3rem; border-radius: 1rem;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 1.4rem; color: #fff;
}
.stat-icon.bg-primary { background: var(--color-primary); }
.stat-icon.bg-success { background: var(--color-success); }
.stat-icon.bg-info { background: var(--color-info); color: #000; }
.stat-icon.bg-warning { background: var(--color-warning); color: #000; }
.stat-icon.bg-danger { background: var(--color-danger); }
.stat-icon.bg-purple { background: #6f42c1; }
.stat-link { font-size: 0.85rem; color: var(--color-primary); font-weight: 600; margin-top: auto; }

/* --- Empty states --- */
.empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--color-gray-500);
}
.empty-state i { font-size: 3rem; margin-bottom: 1rem; opacity: 0.4; }
.empty-state h3 { margin-bottom: 0.5rem; }

/* --- Responsive --- */
@media (max-width: 991.98px) {
  .main-content { padding-left: 0; }
  .main-content .container { padding-left: 1rem; padding-right: 1rem; }
}
